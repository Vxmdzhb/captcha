{
    "name": "astrx/captcha",
    "description": "Image captchas that work without JavaScript, with an optional reload frame.",
    "license": "LicenseRef-DoWhatever",
    "type": "library",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered"
    ],
    "homepage": "https://github.com/Vxmdzhb/captcha",
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "ext-pdo": "*",
        "astrx/config": "self.version",
        "astrx/http": "self.version",
        "astrx/i18n": "self.version",
        "astrx/kernel": "self.version",
        "astrx/result": "self.version",
        "astrx/routing": "self.version",
        "astrx/support": "self.version",
        "astrx/template": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "AstrX\\Captcha\\": ""
        }
    },
    "extra": {
        "astrx": {
            "resources": "resources"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/result"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/support"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/config"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/http"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/routing"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/i18n"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/template"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/session"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/kernel"
        }
    ]
}
